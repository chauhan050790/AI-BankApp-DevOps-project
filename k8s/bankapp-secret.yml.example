# Example only. Prefer External Secrets/Secrets Manager in shared environments.
# If creating this Secret manually, do not commit the populated manifest.
apiVersion: v1
kind: Secret
metadata:
  name: bankapp-secret
  namespace: bankapp
type: Opaque
stringData:
  MYSQL_ROOT_PASSWORD: replace-with-a-long-random-root-password
  MYSQL_USER: bankapp
  MYSQL_PASSWORD: replace-with-a-long-random-application-password
